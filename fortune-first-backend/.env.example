# Used when running the backend directly on the host (npm run dev/migrate/seed).
# When run via `docker compose up`, docker-compose.yml overrides DATABASE_URL/
# REDIS_URL/PORT to point at the compose network instead — everything below
# still gets loaded into the container as-is via env_file.
DATABASE_URL=postgresql://ff_user:change_me@localhost:5432/fortunefirst
REDIS_URL=redis://localhost:6379
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
RESEND_API_KEY=re_your_resend_api_key
TWELVE_DATA_API_KEY=your_twelve_data_api_key
# 64 hex chars (32 bytes) recommended, e.g. `openssl rand -hex 32` — used to
# encrypt PAN/bank account numbers at rest (NFR-SEC-06).
AES_ENCRYPTION_KEY=replace_with_a_random_32_byte_key
