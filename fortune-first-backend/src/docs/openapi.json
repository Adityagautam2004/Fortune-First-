{
  "openapi": "3.0.3",
  "info": {
    "title": "Fortune First Backend API",
    "version": "1.0.0",
    "description": "REST API for the Fortune First investment management platform.\n\n### Roles\n`customer`, `investment_head`, `business_head`, `super_admin` — enforced via `requireAuth` (valid JWT access token) and `requireRole(...)` on each route below.\n\n### Response shape\nMost endpoints return `{ \"status\": \"success\"|\"error\", \"message\": string, \"data\": ... }`. Routes built on the newer `ApiResponse` helper (`/users`, `/investments`, `/payouts`) instead return `{ \"success\": boolean, \"message\": string, \"data\": ... }`. Both are documented exactly as implemented below — this is a real inconsistency in the codebase, not a documentation error.\n\n### Known issues in the current implementation\n- `POST /board/investments` and `POST /board/payouts` are registered server-side without a leading slash (`'investments'`, `'process-payouts'`) — as written they do not match the paths the frontend actually calls and are effectively unreachable. Documented here as the frontend calls them; fix pending.\n- `PUT /auth/change-password` — the frontend calls this with `PUT`, but only `POST /auth/change-password` is registered. Documented as currently implemented (`POST`).\n- `POST /investments` and `POST /payouts` read `req.user.id`, but the JWT payload only contains `userId` — so `recorded_by`/`processed_by` are saved as `undefined` rather than the acting user's id.\n- `GET /board/dashboard` always filters by `assigned_to`, so `business_head` users (who see all clients, not just assigned ones, per `GET /board/clients`) currently get zero stats back.\n- `DELETE /admin/portfolio/{id}` filters by `owner_id = req.user.userId` (the same scoping used by the board's own `DELETE /board/portfolio/{id}`, where it's correct) — but a super_admin has no portfolio positions of their own, so this endpoint can never actually delete anything for anyone else. It always reports success regardless.",
    "contact": { "name": "Fortune First" }
  },
  "servers": [
    { "url": "http://localhost:4000/api/v1", "description": "Local (host or docker compose)" }
  ],
  "tags": [
    { "name": "Health", "description": "Service health check" },
    { "name": "Auth", "description": "Login, token refresh, logout, password change" },
    { "name": "Users", "description": "User administration (super_admin / business_head)" },
    { "name": "Investments", "description": "Investment records" },
    { "name": "Payouts", "description": "Monthly return / payout records" },
    { "name": "Customer", "description": "Customer-only self-service endpoints" },
    { "name": "Board", "description": "Investment Head / Business Head endpoints" },
    { "name": "Admin", "description": "Super Admin console" },
    { "name": "Public", "description": "Unauthenticated public endpoints" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token returned by /auth/login or /auth/refresh, sent as `Authorization: Bearer <token>`. Expires after 15 minutes."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "error" },
          "message": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["customer", "investment_head", "business_head", "super_admin"] },
          "phone": { "type": "string", "nullable": true },
          "is_active": { "type": "boolean" },
          "must_change_password": { "type": "boolean" },
          "assigned_to": { "type": "string", "format": "uuid", "nullable": true },
          "shareholding_pct": { "type": "number" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Investment": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "recorded_by": { "type": "string", "format": "uuid", "nullable": true },
          "amount": { "type": "number", "minimum": 5000 },
          "investment_date": { "type": "string", "format": "date" },
          "week_of_month": { "type": "integer", "minimum": 1, "maximum": 4 },
          "tenure_months": { "type": "integer", "default": 3 },
          "status": { "type": "string", "enum": ["active", "exited", "suspended"] },
          "exit_date": { "type": "string", "format": "date", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "MonthlyReturn": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "investment_id": { "type": "string", "format": "uuid" },
          "month": { "type": "integer", "minimum": 1, "maximum": 12 },
          "year": { "type": "integer" },
          "return_pct": { "type": "number" },
          "payout_amount": { "type": "number" },
          "payout_status": { "type": "string", "enum": ["pending", "paid", "skipped"] },
          "payout_date": { "type": "string", "format": "date", "nullable": true },
          "processed_by": { "type": "string", "format": "uuid", "nullable": true }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check + live DB ping",
        "security": [],
        "responses": {
          "200": {
            "description": "Backend and database are reachable",
            "content": { "application/json": { "example": { "status": "success", "message": "Fortune First Backend is healthy and operational!", "dbTime": "2026-08-13T10:00:00.000Z" } } }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in with email + password",
        "description": "Rate-limited to 20 attempts per IP per 15-minute window (429 after that). Sets an httpOnly `refreshToken` cookie (7d for customers, 1d for staff roles) and returns a 15-minute access token.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" } } } } }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": { "application/json": { "example": { "status": "success", "data": { "accessToken": "eyJ...", "user": { "id": "uuid", "name": "Aditya Gautam", "email": "admin@fortunefirst.com", "role": "super_admin", "mustChangePassword": false } } } } }
          },
          "400": { "description": "Missing email or password" },
          "401": { "description": "Invalid credentials" },
          "403": { "description": "Account suspended" },
          "429": { "description": "Too many failed login attempts" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Exchange a refresh token for a new access token",
        "description": "Reads the refresh token from the httpOnly cookie, or falls back to `refreshToken` in the request body.",
        "security": [],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "refreshToken": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "New access token issued", "content": { "application/json": { "example": { "status": "success", "data": { "accessToken": "eyJ..." } } } } },
          "401": { "description": "Refresh token missing, invalid, expired, or revoked" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log out and revoke the refresh token",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out successfully" },
          "401": { "description": "Missing or invalid access token" }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Set a new password for the current user",
        "description": "Used to clear `must_change_password` on first login. NOTE: the frontend currently calls this endpoint with PUT, not POST — see Known Issues above.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["newPassword"], "properties": { "newPassword": { "type": "string", "format": "password" } } } } }
        },
        "responses": {
          "200": { "description": "Password updated successfully" },
          "401": { "description": "Missing or invalid access token" },
          "500": { "description": "Failed to update password" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request a password reset link",
        "security": [],
        "description": "Always returns the same success message whether or not the email exists, to prevent account enumeration. Generates a random 32-byte token, stores it (plus a 15-minute expiry) on the user, and emails a reset link via Resend.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } } } }
        },
        "responses": { "200": { "description": "If that email exists, a reset link has been sent." } }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Set a new password using a reset token",
        "security": [],
        "description": "Token is single-use — it's cleared as soon as the password is reset, and rejected if expired (15 minutes) or unknown.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["token", "newPassword"], "properties": { "token": { "type": "string" }, "newPassword": { "type": "string", "format": "password" } } } } }
        },
        "responses": {
          "200": { "description": "Password has been successfully reset." },
          "400": { "description": "Invalid or expired reset token" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users (paginated, optional role filter)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin or business_head.",
        "parameters": [
          { "name": "role", "in": "query", "schema": { "type": "string", "enum": ["customer", "investment_head", "business_head", "super_admin"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated user list", "content": { "application/json": { "example": { "success": true, "message": "Success", "data": { "users": [], "pagination": { "total": 0, "page": 1, "limit": 20, "totalPages": 0 } } } } } },
          "403": { "description": "Forbidden — wrong role" }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get a single user by id",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin, business_head, or investment_head.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "User found", "content": { "application/json": { "example": { "success": true, "message": "Success", "data": { "user": {} } } } } },
          "404": { "description": "User not found" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update a user's fields",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin. Allowed fields: name, email, role, phone, assigned_to, shareholding_pct.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "email": { "type": "string" }, "role": { "type": "string" }, "phone": { "type": "string" }, "assigned_to": { "type": "string", "format": "uuid" }, "shareholding_pct": { "type": "number" } } } } }
        },
        "responses": {
          "200": { "description": "User updated successfully" },
          "400": { "description": "No valid fields to update" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/users/{id}/toggle-active": {
      "patch": {
        "tags": ["Users"],
        "summary": "Toggle a user's active status",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin. Flips is_active (no request body).",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "User activated/deactivated successfully" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/investments": {
      "post": {
        "tags": ["Investments"],
        "summary": "Record a new investment",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or super_admin. NOTE: recorded_by is currently saved as undefined — see Known Issues.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["customer_id", "amount", "investment_date", "week_of_month"], "properties": { "customer_id": { "type": "string", "format": "uuid" }, "amount": { "type": "number", "minimum": 5000 }, "investment_date": { "type": "string", "format": "date" }, "week_of_month": { "type": "integer", "minimum": 1, "maximum": 4 }, "tenure_months": { "type": "integer", "default": 3 }, "notes": { "type": "string", "maxLength": 500 } } } } }
        },
        "responses": {
          "201": { "description": "Investment recorded successfully" },
          "400": { "description": "Validation error (Joi)" }
        }
      },
      "get": {
        "tags": ["Investments"],
        "summary": "List investments (paginated, optional filters)",
        "security": [{ "bearerAuth": [] }],
        "description": "Any authenticated user.",
        "parameters": [
          { "name": "customer_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "exited", "suspended"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Paginated investment list" } }
      }
    },
    "/investments/{id}": {
      "get": {
        "tags": ["Investments"],
        "summary": "Get a single investment by id",
        "security": [{ "bearerAuth": [] }],
        "description": "Any authenticated user.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Investment found" }, "404": { "description": "Not found" } }
      }
    },
    "/investments/{id}/status": {
      "patch": {
        "tags": ["Investments"],
        "summary": "Update an investment's status",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or super_admin.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["active", "exited", "suspended"] }, "exit_date": { "type": "string", "format": "date", "nullable": true } } } } }
        },
        "responses": { "200": { "description": "Investment status updated successfully" } }
      }
    },
    "/payouts": {
      "post": {
        "tags": ["Payouts"],
        "summary": "Record a new monthly return / payout",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or super_admin. NOTE: processed_by is currently saved as undefined — see Known Issues.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["investment_id", "month", "year", "return_pct", "payout_amount"], "properties": { "investment_id": { "type": "string", "format": "uuid" }, "month": { "type": "integer", "minimum": 1, "maximum": 12 }, "year": { "type": "integer", "minimum": 2020, "maximum": 2100 }, "return_pct": { "type": "number", "minimum": 0, "maximum": 100 }, "payout_amount": { "type": "number", "minimum": 0 } } } } }
        },
        "responses": {
          "201": { "description": "Payout recorded successfully" },
          "400": { "description": "Validation error (Joi) or duplicate (unique investment/month/year)" }
        }
      }
    },
    "/payouts/summary": {
      "get": {
        "tags": ["Payouts"],
        "summary": "Aggregated payout dashboard data",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: business_head or super_admin.",
        "responses": { "200": { "description": "Summary data" } }
      }
    },
    "/payouts/investment/{investmentId}": {
      "get": {
        "tags": ["Payouts"],
        "summary": "List all monthly returns for an investment",
        "security": [{ "bearerAuth": [] }],
        "description": "Any authenticated user.",
        "parameters": [{ "name": "investmentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "List of monthly returns" } }
      }
    },
    "/payouts/{id}/status": {
      "patch": {
        "tags": ["Payouts"],
        "summary": "Update a payout's status",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: business_head or super_admin.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["payout_status"], "properties": { "payout_status": { "type": "string", "enum": ["pending", "paid", "skipped"] }, "payout_date": { "type": "string", "format": "date", "nullable": true } } } } }
        },
        "responses": { "200": { "description": "Payout status updated successfully" } }
      }
    },
    "/customer/dashboard": {
      "get": {
        "tags": ["Customer"],
        "summary": "Customer's own investment summary",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer. Cached in Redis for 5 minutes per user (`dashboard:{userId}`), invalidated when a new investment or payout is recorded for them.",
        "responses": { "200": { "description": "Dashboard stats", "content": { "application/json": { "example": { "status": "success", "source": "database", "data": { "totalInvested": 50000, "currentValue": 50000, "cagr": 0, "thisMonthReturn": 0 } } } } } }
      }
    },
    "/customer/investments": {
      "get": {
        "tags": ["Customer"],
        "summary": "Customer's own investment + payout history",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer.",
        "responses": { "200": { "description": "Investment history" } }
      }
    },
    "/customer/profile": {
      "get": {
        "tags": ["Customer"],
        "summary": "Customer's own profile + KYC status",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer. `pan_number_enc` is returned masked as `pan_masked` (e.g. ABCDE****F).",
        "responses": { "200": { "description": "Profile data" }, "404": { "description": "User not found" } }
      }
    },
    "/customer/kyc": {
      "post": {
        "tags": ["Customer"],
        "summary": "Submit or update KYC details",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer. Upserts (one KYC record per user).",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "panNumber": { "type": "string" }, "bankName": { "type": "string" }, "accountNumber": { "type": "string" }, "ifscCode": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "KYC submitted for verification" } }
      }
    },
    "/customer/support": {
      "get": {
        "tags": ["Customer"],
        "summary": "List the customer's own support tickets",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer.",
        "responses": { "200": { "description": "Ticket list" } }
      },
      "post": {
        "tags": ["Customer"],
        "summary": "Create a support ticket",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["subject", "category", "message"], "properties": { "subject": { "type": "string" }, "category": { "type": "string" }, "message": { "type": "string" } } } } }
        },
        "responses": { "201": { "description": "Ticket created successfully" } }
      }
    },
    "/customer/report/full": {
      "get": {
        "tags": ["Customer"],
        "summary": "Download a full PDF investment report",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer. Returns a binary PDF, not JSON.",
        "responses": { "200": { "description": "PDF file", "content": { "application/pdf": {} } } }
      }
    },
    "/board/dashboard": {
      "get": {
        "tags": ["Board"],
        "summary": "Board member's assigned-client summary",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. See Known Issues — currently returns zero for business_head.",
        "responses": { "200": { "description": "Stats", "content": { "application/json": { "example": { "status": "success", "data": { "total_clients": "1", "total_aum": "50000.00" } } } } } }
      }
    },
    "/board/clients": {
      "get": {
        "tags": ["Board"],
        "summary": "List clients visible to this board member",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. investment_head sees only clients with assigned_to = self; business_head sees all customers.",
        "responses": { "200": { "description": "Client list" } }
      }
    },
    "/board/clients/{id}/investments/active": {
      "get": {
        "tags": ["Board"],
        "summary": "Get a client's active investments",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. No ownership check against assigned_to — any board member can query any customer id.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Customer id" }],
        "responses": { "200": { "description": "List of active investments for that customer" } }
      }
    },
    "/board/investments": {
      "post": {
        "tags": ["Board"],
        "summary": "Record an investment for an assigned client",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head (enforced again inside the controller). KNOWN ISSUE: registered server-side as `'investments'` (no leading slash) — likely unreachable as written.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["customerId", "amount", "investmentDate", "weekOfMonth"], "properties": { "customerId": { "type": "string", "format": "uuid" }, "amount": { "type": "number" }, "investmentDate": { "type": "string", "format": "date" }, "weekOfMonth": { "type": "integer" }, "notes": { "type": "string" } } } } }
        },
        "responses": { "201": { "description": "Investment recorded successfully" }, "400": { "description": "Amount below 5000 or not a multiple of 5000" } }
      }
    },
    "/board/payouts": {
      "post": {
        "tags": ["Board"],
        "summary": "Process a monthly payout for an investment",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head (enforced again inside the controller). KNOWN ISSUE: registered server-side as `'process-payouts'` (no leading slash, different name) — does not match this path as written.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["investmentId", "month", "year", "returnPct"], "properties": { "investmentId": { "type": "string", "format": "uuid" }, "month": { "type": "integer" }, "year": { "type": "integer" }, "returnPct": { "type": "number" } } } } }
        },
        "responses": { "200": { "description": "Payout processed", "content": { "application/json": { "example": { "status": "success", "data": { "payoutAmount": 1000 } } } } }, "400": { "description": "Payout already processed for this month" } }
      }
    },
    "/board/payouts/{returnId}/void": {
      "patch": {
        "tags": ["Board"],
        "summary": "Void a processed payout",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. Sets payout_status to 'voided' (keeps the row for historical integrity) and writes an audit_logs entry.",
        "parameters": [{ "name": "returnId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Payout voided successfully" } }
      }
    },
    "/board/chat/{conversationId}": {
      "get": {
        "tags": ["Board"],
        "summary": "Get the last 50 messages in a conversation",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. Use `group_all` for the shared board conversation.",
        "parameters": [{ "name": "conversationId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Chat history, oldest first" } }
      }
    },
    "/board/portfolio": {
      "get": {
        "tags": ["Board"],
        "summary": "Get the board member's live personal portfolio",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. Enriches each position with a live price from the Twelve Data API (cached 5 min in Redis) and computed P&L.",
        "responses": { "200": { "description": "Enriched positions" } }
      },
      "post": {
        "tags": ["Board"],
        "summary": "Add a manual portfolio position",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["symbol", "quantity", "buyPrice"], "properties": { "symbol": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 }, "buyPrice": { "type": "number" } } } } }
        },
        "responses": { "201": { "description": "Position added" } }
      }
    },
    "/board/portfolio/{id}": {
      "delete": {
        "tags": ["Board"],
        "summary": "Remove one of this board member's own portfolio positions",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. Scoped to owner_id = the caller's own id, so it can only delete the caller's own positions.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Position removed (succeeds even if no row matched)" } }
      }
    },
    "/admin/dashboard": {
      "get": {
        "tags": ["Admin"],
        "summary": "System-wide analytics",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin.",
        "responses": { "200": { "description": "Stats", "content": { "application/json": { "example": { "status": "success", "data": { "totalClients": 1, "totalAum": 50000, "monthlyPayouts": 0 } } } } } }
      }
    },
    "/admin/users": {
      "get": {
        "tags": ["Admin"],
        "summary": "List every user in the system",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin.",
        "responses": { "200": { "description": "User list" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Create a new user (staff or customer)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin. Sets must_change_password = true for the new account.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["name", "email", "password", "role"], "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" }, "role": { "type": "string", "enum": ["customer", "investment_head", "business_head", "super_admin"] }, "phone": { "type": "string" }, "assignedTo": { "type": "string", "format": "uuid" } } } } }
        },
        "responses": { "201": { "description": "User created" }, "400": { "description": "Email already exists" } }
      }
    },
    "/admin/join-requests": {
      "get": {
        "tags": ["Admin"],
        "summary": "List public join requests",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin.",
        "responses": { "200": { "description": "Join request list" } }
      }
    },
    "/admin/join-requests/{id}/status": {
      "put": {
        "tags": ["Admin"],
        "summary": "Approve or reject a join request",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin. Approving does not currently auto-create the user account.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["Approved", "Rejected"] } } } } }
        },
        "responses": { "200": { "description": "Request marked as Approved/Rejected" } }
      }
    },
    "/admin/portfolio/{id}": {
      "delete": {
        "tags": ["Admin"],
        "summary": "Remove a portfolio position",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin. KNOWN ISSUE: scoped to owner_id = the caller's own id (copied from the board version), so as written a super_admin can never actually delete another user's position — the delete matches zero rows and still returns success. See Known Issues.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Returns success even when no row was deleted" } }
      }
    },
    "/admin/support": {
      "get": {
        "tags": ["Admin"],
        "summary": "List every support ticket, across all customers",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin.",
        "responses": { "200": { "description": "Ticket list, newest first, joined with customer name/email" } }
      }
    },
    "/admin/support/{id}/resolve": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Mark a support ticket as resolved",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Ticket marked as resolved" } }
      }
    },
    "/public/join-request": {
      "post": {
        "tags": ["Public"],
        "summary": "Submit a public \"request to invest\" form",
        "security": [],
        "description": "No authentication required. Used by the marketing site's lead-capture form.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["name", "email"], "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "phone": { "type": "string" }, "amount": { "type": "string" }, "message": { "type": "string" } } } } }
        },
        "responses": { "201": { "description": "Request submitted successfully" } }
      }
    }
  }
}
