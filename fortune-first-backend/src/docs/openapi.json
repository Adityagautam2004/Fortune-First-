{
  "openapi": "3.0.3",
  "info": {
    "title": "Fortune First Backend API",
    "version": "2.0.0",
    "description": "REST API for the Fortune First investment management platform.\n\n### Roles\n`customer`, `investment_head`, `business_head`, `super_admin` — enforced via `requireAuth` (valid JWT access token) and `requireRole(...)` on each route below.\n\n### Route structure\nEverything lives under the SRS's role-namespaced structure (3.1.2): `/auth`, `/customer/*`, `/board/*`, `/admin/*`, `/public/*`. There used to be a separate flat `/users`, `/investments`, `/payouts` route family; that's been folded entirely into `/admin/*` (same underlying service functions, just consistently namespaced).\n\n### Known issues in the current implementation\n- `PUT /auth/change-password` — the frontend calls this with `PUT`, but only `POST /auth/change-password` is registered.\n- `GET /board/dashboard` always filters by `assigned_to`, so `business_head` users (who see all clients, not just assigned ones, per `GET /board/clients`) currently get zero stats back.\n- `DELETE /admin/portfolio/{id}` filters by `owner_id = req.user.userId` (the same scoping used by the board's own `DELETE /board/portfolio/{id}`, where it's correct) — but a super_admin has no portfolio positions of their own, so this endpoint can never actually delete anything for anyone else. It always reports success regardless.\n- `GET /board/clients/{id}/investments/active` has no ownership check against `assigned_to` — any board member can query any customer id, by design choice (not fixed).",
    "contact": { "name": "Fortune First" }
  },
  "servers": [
    { "url": "http://localhost:4000/api/v1", "description": "Local (host or docker compose)" }
  ],
  "tags": [
    { "name": "Health", "description": "Service health check" },
    { "name": "Auth", "description": "Login, token refresh, logout, password change/reset" },
    { "name": "Customer", "description": "Customer-only self-service endpoints" },
    { "name": "Board", "description": "Investment Head / Business Head endpoints" },
    { "name": "Admin", "description": "Super Admin console" },
    { "name": "Public", "description": "Unauthenticated public endpoints" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token returned by /auth/login or /auth/refresh, sent as `Authorization: Bearer <token>`. Expires after 15 minutes."
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check + live DB ping",
        "security": [],
        "responses": {
          "200": {
            "description": "Backend and database are reachable",
            "content": { "application/json": { "example": { "status": "success", "message": "Fortune First Backend is healthy and operational!", "dbTime": "2026-08-13T10:00:00.000Z" } } }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in with email + password",
        "description": "Rate-limited to 20 attempts per IP per 15-minute window (429 after that). Sets an httpOnly `refreshToken` cookie (7d for customers, 1d for staff roles) and returns a 15-minute access token.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" } } } } }
        },
        "responses": {
          "200": { "description": "Login successful", "content": { "application/json": { "example": { "status": "success", "data": { "accessToken": "eyJ...", "user": { "id": "uuid", "name": "Aditya Gautam", "email": "admin@fortunefirst.com", "role": "super_admin", "mustChangePassword": false } } } } } },
          "400": { "description": "Missing email or password" },
          "401": { "description": "Invalid credentials" },
          "403": { "description": "Account suspended" },
          "429": { "description": "Too many failed login attempts" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Exchange a refresh token for a new access token",
        "description": "Reads the refresh token from the httpOnly cookie, or falls back to `refreshToken` in the request body.",
        "security": [],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object", "properties": { "refreshToken": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "New access token issued", "content": { "application/json": { "example": { "status": "success", "data": { "accessToken": "eyJ..." } } } } },
          "401": { "description": "Refresh token missing, invalid, expired, or revoked" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log out and revoke the refresh token",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Logged out successfully" }, "401": { "description": "Missing or invalid access token" } }
      }
    },
    "/auth/change-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Set a new password for the current user",
        "description": "Used to clear `must_change_password` on first login. NOTE: the frontend currently calls this endpoint with PUT, not POST — see Known Issues above.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["newPassword"], "properties": { "newPassword": { "type": "string", "format": "password" } } } } } },
        "responses": { "200": { "description": "Password updated successfully" }, "401": { "description": "Missing or invalid access token" }, "500": { "description": "Failed to update password" } }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request a password reset link",
        "security": [],
        "description": "Always returns the same success message whether or not the email exists, to prevent account enumeration. Generates a random 32-byte token, stores it (plus a 15-minute expiry) on the user, and emails a reset link via Resend.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } } } } },
        "responses": { "200": { "description": "If that email exists, a reset link has been sent." } }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Set a new password using a reset token",
        "security": [],
        "description": "Token is single-use — it's cleared as soon as the password is reset, and rejected if expired (15 minutes) or unknown.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["token", "newPassword"], "properties": { "token": { "type": "string" }, "newPassword": { "type": "string", "format": "password" } } } } } },
        "responses": { "200": { "description": "Password has been successfully reset." }, "400": { "description": "Invalid or expired reset token" } }
      }
    },
    "/customer/dashboard": {
      "get": {
        "tags": ["Customer"],
        "summary": "Customer's own investment summary",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer. Cached in Redis for 5 minutes per user (`dashboard:{userId}`), invalidated when a new investment or payout is recorded for them.",
        "responses": { "200": { "description": "Dashboard stats", "content": { "application/json": { "example": { "status": "success", "source": "database", "data": { "totalInvested": 50000, "currentValue": 50000, "cagr": 0, "thisMonthReturn": 0 } } } } } }
      }
    },
    "/customer/investments": {
      "get": {
        "tags": ["Customer"],
        "summary": "Customer's own investment + payout history",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer.",
        "responses": { "200": { "description": "Investment history" } }
      }
    },
    "/customer/profile": {
      "get": {
        "tags": ["Customer"],
        "summary": "Customer's own profile + KYC status",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer. PAN/account numbers are AES-256-GCM encrypted at rest; this endpoint decrypts server-side just long enough to mask them as `pan_masked`/`account_masked` — the raw encrypted or plaintext values never leave the server.",
        "responses": { "200": { "description": "Profile data" }, "404": { "description": "User not found" } }
      }
    },
    "/customer/kyc": {
      "post": {
        "tags": ["Customer"],
        "summary": "Submit or update KYC details",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer. Upserts (one KYC record per user). PAN and account number are encrypted (AES-256-GCM) before storage (NFR-SEC-06).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "panNumber": { "type": "string" }, "bankName": { "type": "string" }, "accountNumber": { "type": "string" }, "ifscCode": { "type": "string" } } } } } },
        "responses": { "200": { "description": "KYC submitted for verification" } }
      }
    },
    "/customer/support": {
      "get": { "tags": ["Customer"], "summary": "List the customer's own support tickets", "security": [{ "bearerAuth": [] }], "description": "Requires role: customer.", "responses": { "200": { "description": "Ticket list" } } },
      "post": {
        "tags": ["Customer"],
        "summary": "Create a support ticket",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["subject", "category", "message"], "properties": { "subject": { "type": "string" }, "category": { "type": "string" }, "message": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Ticket created successfully" } }
      }
    },
    "/customer/report/full": {
      "get": { "tags": ["Customer"], "summary": "Download a full PDF investment report", "security": [{ "bearerAuth": [] }], "description": "Requires role: customer. Returns a binary PDF, not JSON.", "responses": { "200": { "description": "PDF file", "content": { "application/pdf": {} } } } }
    },
    "/customer/report/monthly": {
      "get": {
        "tags": ["Customer"],
        "summary": "Download a single month's PDF report (FR-CUST-09)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: customer.",
        "parameters": [
          { "name": "month", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1, "maximum": 12 } },
          { "name": "year", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "PDF file", "content": { "application/pdf": {} } }, "404": { "description": "No records for that month" } }
      }
    },
    "/board/dashboard": {
      "get": { "tags": ["Board"], "summary": "Board member's assigned-client summary", "security": [{ "bearerAuth": [] }], "description": "Requires role: investment_head or business_head. See Known Issues — currently returns zero for business_head.", "responses": { "200": { "description": "Stats" } } }
    },
    "/board/clients": {
      "get": { "tags": ["Board"], "summary": "List clients visible to this board member", "security": [{ "bearerAuth": [] }], "description": "Requires role: investment_head or business_head. investment_head sees only clients with assigned_to = self; business_head sees all customers.", "responses": { "200": { "description": "Client list" } } }
    },
    "/board/clients/{id}": {
      "get": {
        "tags": ["Board"],
        "summary": "Full detail view of a single client (FR-IH-03)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. Returns profile, investment list, and a YTD summary.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Client detail" }, "404": { "description": "Client not found" } }
      }
    },
    "/board/clients/{id}/investments/active": {
      "get": {
        "tags": ["Board"],
        "summary": "Get a client's active investments",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. No ownership check against assigned_to — see Known Issues.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Customer id" }],
        "responses": { "200": { "description": "Active investments for that customer" } }
      }
    },
    "/board/clients/{id}/send-report": {
      "post": {
        "tags": ["Board"],
        "summary": "Generate and email a client's PDF report (FR-IH-06)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or super_admin.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Report sent successfully" }, "403": { "description": "Forbidden" }, "404": { "description": "Client not found" } }
      }
    },
    "/board/clients/{id}/send-email": {
      "post": {
        "tags": ["Board"],
        "summary": "Compose and send a custom email to a client (FR-IH-07)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or super_admin.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["subject", "message"], "properties": { "subject": { "type": "string" }, "message": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Email sent successfully" }, "403": { "description": "Forbidden" }, "404": { "description": "Client not found" } }
      }
    },
    "/board/return-rate": {
      "get": { "tags": ["Board"], "summary": "Read-only global monthly return rate default (FR-IH-12)", "security": [{ "bearerAuth": [] }], "description": "Requires role: investment_head or business_head.", "responses": { "200": { "description": "Current rate" } } }
    },
    "/board/investments": {
      "post": {
        "tags": ["Board"],
        "summary": "Record an investment for an assigned client",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head (enforced again inside the controller). Wrapped in a DB transaction with its audit log entry (NFR-REL-04).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["customerId", "amount", "investmentDate", "weekOfMonth"], "properties": { "customerId": { "type": "string", "format": "uuid" }, "amount": { "type": "number" }, "investmentDate": { "type": "string", "format": "date" }, "weekOfMonth": { "type": "integer" }, "notes": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Investment recorded successfully" }, "400": { "description": "Amount below 5000 or not a multiple of 5000" } }
      }
    },
    "/board/payouts/pending": {
      "get": {
        "tags": ["Board"],
        "summary": "List investments due a payout this month (FR-IH-11)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. Active investments with no monthly_returns row yet for the given month/year (defaults to current month). investment_head is scoped to assigned clients only.",
        "parameters": [
          { "name": "month", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 12 } },
          { "name": "year", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Pending investments for the period" } }
      }
    },
    "/board/payouts": {
      "post": {
        "tags": ["Board"],
        "summary": "Process a monthly payout for an investment",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head (enforced again inside the controller).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["investmentId", "month", "year", "returnPct"], "properties": { "investmentId": { "type": "string", "format": "uuid" }, "month": { "type": "integer" }, "year": { "type": "integer" }, "returnPct": { "type": "number" } } } } } },
        "responses": { "200": { "description": "Payout processed", "content": { "application/json": { "example": { "status": "success", "data": { "payoutAmount": 1000 } } } } }, "400": { "description": "Payout already processed for this month" } }
      }
    },
    "/board/payouts/{returnId}/void": {
      "patch": {
        "tags": ["Board"],
        "summary": "Void a processed payout",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head. Sets payout_status to 'voided' (keeps the row for historical integrity) and writes an audit_logs entry including the prior status as old_value.",
        "parameters": [{ "name": "returnId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Payout voided successfully" } }
      }
    },
    "/board/chat/{conversationId}": {
      "get": { "tags": ["Board"], "summary": "Get the last 50 messages in a conversation", "security": [{ "bearerAuth": [] }], "description": "Requires role: investment_head or business_head. Use `group_all` for the shared board conversation.", "parameters": [{ "name": "conversationId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Chat history, oldest first" } } }
    },
    "/board/portfolio": {
      "get": { "tags": ["Board"], "summary": "Get the board member's live personal portfolio", "security": [{ "bearerAuth": [] }], "description": "Requires role: investment_head or business_head. Enriches each position with a live price from the Twelve Data API (cached 5 min in Redis) and computed P&L.", "responses": { "200": { "description": "Enriched positions" } } },
      "post": {
        "tags": ["Board"],
        "summary": "Add a manual portfolio position",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: investment_head or business_head.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["symbol", "quantity", "buyPrice"], "properties": { "symbol": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 }, "buyPrice": { "type": "number" } } } } } },
        "responses": { "201": { "description": "Position added" } }
      }
    },
    "/board/portfolio/{id}": {
      "delete": { "tags": ["Board"], "summary": "Remove one of this board member's own portfolio positions", "security": [{ "bearerAuth": [] }], "description": "Requires role: investment_head or business_head. Scoped to owner_id = the caller's own id.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Position removed (succeeds even if no row matched)" } } }
    },
    "/admin/dashboard": {
      "get": { "tags": ["Admin"], "summary": "System-wide analytics", "security": [{ "bearerAuth": [] }], "description": "Requires role: super_admin.", "responses": { "200": { "description": "Stats", "content": { "application/json": { "example": { "status": "success", "data": { "totalClients": 1, "totalAum": 50000, "monthlyPayouts": 0 } } } } } } }
    },
    "/admin/users": {
      "get": {
        "tags": ["Admin"],
        "summary": "List users, with optional filters (FR-ADMIN-05)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin. Response is a flat array in `data` (not paginated in this UI).",
        "parameters": [
          { "name": "role", "in": "query", "schema": { "type": "string", "enum": ["customer", "investment_head", "business_head", "super_admin"] } },
          { "name": "assignedTo", "in": "query", "schema": { "type": "string", "format": "uuid" }, "description": "Filter customers by their assigned investment head" },
          { "name": "isActive", "in": "query", "schema": { "type": "string", "enum": ["true", "false"] } }
        ],
        "responses": { "200": { "description": "User list" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Create a new user (staff or customer) — FR-ADMIN-04/08",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin. Sets must_change_password = true for the new account.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name", "email", "password", "role"], "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" }, "role": { "type": "string", "enum": ["customer", "investment_head", "business_head", "super_admin"] }, "phone": { "type": "string" }, "assignedTo": { "type": "string", "format": "uuid" } } } } } },
        "responses": { "201": { "description": "User created" }, "400": { "description": "Email already exists" } }
      }
    },
    "/admin/users/{id}": {
      "get": { "tags": ["Admin"], "summary": "Get a single user by id", "security": [{ "bearerAuth": [] }], "description": "Requires role: super_admin.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "User found" }, "404": { "description": "Not found" } } },
      "patch": {
        "tags": ["Admin"],
        "summary": "Edit a user's profile / assignment (FR-ADMIN-06)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin. Allowed fields: name, email, role, phone, assigned_to, shareholding_pct.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "email": { "type": "string" }, "role": { "type": "string" }, "phone": { "type": "string" }, "assigned_to": { "type": "string", "format": "uuid" }, "shareholding_pct": { "type": "number" } } } } } },
        "responses": { "200": { "description": "User updated successfully" }, "400": { "description": "No valid fields to update" }, "404": { "description": "User not found" } }
      }
    },
    "/admin/users/{id}/toggle-active": {
      "patch": { "tags": ["Admin"], "summary": "Suspend/activate a user (FR-ADMIN-07)", "security": [{ "bearerAuth": [] }], "description": "Requires role: super_admin. Flips is_active (no request body).", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "User activated/deactivated successfully" }, "404": { "description": "User not found" } } }
    },
    "/admin/investments": {
      "get": {
        "tags": ["Admin"],
        "summary": "View all investments across all clients (FR-ADMIN-14)",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin. Paginated, filterable by customer_id/status.",
        "parameters": [
          { "name": "customer_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "exited", "suspended"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Paginated investment list" } }
      }
    },
    "/admin/investments/{id}": {
      "get": { "tags": ["Admin"], "summary": "Get a single investment by id", "security": [{ "bearerAuth": [] }], "description": "Requires role: super_admin.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Investment found" }, "404": { "description": "Not found" } } }
    },
    "/admin/investments/{id}/status": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Update an investment's status",
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role: super_admin.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["active", "exited", "suspended"] }, "exit_date": { "type": "string", "format": "date", "nullable": true } } } } } },
        "responses": { "200": { "description": "Investment status updated successfully" } }
      }
    },
    "/admin/investments/{id}/payouts": {
